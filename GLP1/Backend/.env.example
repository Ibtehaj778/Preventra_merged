# GLP-1 Analytics API — copy to .env and fill in.
# This service VERIFIES tokens; it does not issue them.

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=glp1_analytics
DATA_DIR=./data

# Parsed as a JSON list — keep the brackets and the double quotes.
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173","http://localhost:5175"]

# MUST be byte-identical to SHARED_SECRET_KEY on the Readmissions API, which is
# the single issuer of tokens for both products. Generate once, with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SHARED_SECRET_KEY=
SHARED_IDENTITY_DB_NAME=shared_identity

# Chatbot — optional. Leave GOOGLE_API_KEY empty to disable live replies; the
# endpoint still answers, with a "not configured" message, so the UI holds up.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
CHATBOT_ENABLED=true
