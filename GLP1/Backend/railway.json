{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "core/**",
      "routers/**",
      "schemas/**",
      "main.py",
      "requirements.txt",
      "Dockerfile",
      ".dockerignore",
      "railway.json",
      "data/final_gb_model.pkl",
      "data/shap_values_test.npy"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "numReplicas": 1
  }
}
