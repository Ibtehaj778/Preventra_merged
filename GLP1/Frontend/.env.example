# Vite reads these at BUILD time. Changing one on a deployed site needs a
# redeploy, not a restart.

# This product's own backend.
VITE_API_URL=http://localhost:8000

# The shared auth service (the Readmissions API). Sign-in and sign-up go here,
# nothing else does.
VITE_AUTH_URL=http://localhost:8001

# Where the sidebar app switcher sends people.
VITE_READMISSIONS_URL=http://localhost:5174

# The shared sign-in page. When set, signing out returns here and anyone without
# a session is sent here; leave it blank and this app falls back to its own
# built-in /login screen.
VITE_PORTAL_URL=http://localhost:5175
