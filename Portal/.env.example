# Portal — set these in the deployment platform's project settings (Vercel:
# Settings → Environment Variables). build.js reads them and writes config.js
# into dist/, so no deployed URL is committed to the repository.
#
# Read at BUILD time: changing one needs a redeploy, not a restart.

# The Readmissions API — the single issuer of tokens for both products. This
# portal's origin must appear in that service's ALLOWED_ORIGINS, or the browser
# blocks the sign-in call and it looks like the service is down.
PORTAL_AUTH_BASE_URL=http://localhost:8001

# Where each tile sends people. Origin only — no path, no trailing slash.
# Leave one blank and its tile reports itself as not configured.
PORTAL_GLP1_URL=http://localhost:5173
PORTAL_READMISSIONS_URL=http://localhost:5174
